DB_HOST=localhost
DB_PORT=3306
DB_NAME=elearning_emotion
DB_USER=root
DB_PASSWORD=123456

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

JWT_SECRET=doi-chuoi-nay-toi-thieu-32-ky-tu-truoc-khi-deploy-that

# Dia chi ai-service (Python) - xem thu muc /ai-service
AI_SERVICE_URL=http://localhost:8000

# LanguageTool kiem tra chinh ta va ngu phap tieng Anh cuc bo (Phase AG-6)
LANGUAGETOOL_URL=http://localhost:8010/v2/check

# Lop phan tich LLM tuy chon (Phase AG-7 - Mac dinh tat: false)
MODERATION_LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Cau hinh Thanh toan & SePay Webhook (Phase H1)
PAYMENT_BANK_ID=MB
PAYMENT_ACCOUNT_NO=0000000000
PAYMENT_ACCOUNT_NAME=E-Learning AI
PAYMENT_QR_TEMPLATE=compact2
SEPAY_API_KEY=your_sepay_api_key_here
PLATFORM_FEE_PERCENT=5
MIN_PAYOUT_AMOUNT=50000
ORDER_EXPIRE_HOURS=24

# Cho phep tao du lieu demo canh bao hoc tap (Dev only)
ALERT_DEMO_SEED_ENABLED=false

# Gui mail OTP qua Brevo HTTP API (Render chan SMTP cong 25/465/587 nen khong dung Gmail SMTP)
# BREVO_SENDER_EMAIL phai la email da xac minh trong Brevo > Settings > Senders, domains & Dedicated IPs
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
MAIL_SENDER_NAME=E-Learning AI
# Chi dat true khi chay LOCAL de nhan OTP khi gui mail loi. PRODUCTION de false hoac bo trong.
APP_AUTH_EXPOSE_DEV_OTP=false

# Chatbot AI (Tư vấn khóa học & Giải thích câu sai)
# Hỗ trợ cả OpenAI (gpt-4o-mini) lẫn Google Gemini (gemini-1.5-flash)
CHAT_LLM_ENABLED=false
# Cấu hình mặc định (OpenAI):
CHAT_LLM_MODEL=gpt-4o-mini
CHAT_LLM_API_KEY=
CHAT_LLM_API_URL=https://api.openai.com/v1/chat/completions
# Kênh Server-Sent Events (SSE) Realtime dùng chung (true/false)
APP_REALTIME_ENABLED=true

# Chương trình hoàn tiền thưởng 10% và giữ tiền (Phase 1+)
REWARD_ENABLED=false

# Mui gio he thong: BAT BUOC la gio Viet Nam. App tu ep Asia/Ho_Chi_Minh luc khoi dong,
# neu ghi de DB_PARAMS thi phai giu serverTimezone=Asia/Ho_Chi_Minh (khong dung UTC).
TZ=Asia/Ho_Chi_Minh
