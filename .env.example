# ==============================================================================
# Emotion-Aware Elearning Platform & Moderation System Environment Configuration
# ==============================================================================

# Database Settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=elearning_emotion
DB_USER=root
DB_PASSWORD=your_secure_db_password_here

# Backend Service
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_secure_jwt_secret_with_at_least_32_characters!

# Local External AI & NLP Services
AI_SERVICE_URL=http://ai-service:8000
LANGUAGETOOL_URL=http://languagetool:8010/v2/check

# Optional LLM Moderation Layer (Phase AG-7)
MODERATION_LLM_ENABLED=false
MODERATION_LLM_PROVIDER=gemini
MODERATION_LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_or_openai_api_key_here

# Payment & SePay Webhook Settings
PAYMENT_BANK_ID=MB
PAYMENT_ACCOUNT_NO=0000000000
PAYMENT_ACCOUNT_NAME=E-Learning AI
PAYMENT_QR_TEMPLATE=compact2
SEPAY_API_KEY=your_sepay_api_key_here
PLATFORM_FEE_PERCENT=0
PAYMENT_HOLD_DAYS=7
MIN_PAYOUT_AMOUNT=200000
ORDER_EXPIRE_HOURS=24

# Demo seed data (dev only)
ALERT_DEMO_SEED_ENABLED=false
