# Tất cả đều TÙY CHỌN. Đặt trước khi chạy uvicorn.
AI_ALLOW_NO_SECRET=true
# AI_SERVICE_SECRET=cung-gia-tri-voi-backend
# AI_DEBUG=1                # in số đo từng khung (EAR/MAR/yaw/pitch/điểm) ra terminal để so với emotion_demo --debug
# AI_CALIB_SEC=5            # giây hiệu chỉnh đầu phiên (học viên nhìn màn hình tự nhiên)
# AI_WINDOW_SEC=1.2         # cửa sổ thời gian (giây), mặc định = emotion_demo
# AI_CONFUSED_THRESHOLD=0.25   # điểm Bối rối phải >= mức này ...
# AI_CONFUSED_FOCUS_MAX=0.65    # ... VÀ tỉ lệ Tập trung < mức này mới tính Bối rối
# AI_BORED_THRESHOLD=0.38     # giảm nếu "Chán" khó lên
# AI_INTERESTED_THRESHOLD=0.60  # Hứng thú >= mức này -> INTERESTED (nhưng nhường Bối rối nếu bối rối đủ ngưỡng)
# AI_INTERESTED_OVERRIDE=0.90   # Hứng thú >= mức này: ưu tiên cao nhất, bỏ qua mọi cảm xúc khác (kể cả bối rối > 25%)
# AI_BROW_CONFUSED_WEIGHT=0.35  # cau mày tối đa cộng bấy nhiêu vào điểm Bối rối (trước là 0.55)
# AI_PROC_WIDTH=480
